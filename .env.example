# =============================================================================
# Valura AI — Team Lead Assignment — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values you need.
# Never commit your .env file.

# --- LLM (required) ---
# Used by the intent classifier and the Portfolio Health agent.
OPENAI_API_KEY=sk-...

# Use gpt-4o-mini during development to keep costs down.
# Evaluation runs against gpt-4.1.
OPENAI_MODEL=gpt-4o-mini
MODEL_NAME=gpt-4o-mini

# --- Application ---
APP_ENV=development              # development | production | test
PIPELINE_TIMEOUT_SECONDS=15

# --- Classifier (stretch / tuning) ---
# JSON map of tenant_id -> OpenAI model name, e.g. {"premium":"gpt-4.1","free":"gpt-4o-mini"}
TENANT_MODEL_OVERRIDES={}
# Fallback model when tenant is missing from overrides
DEFAULT_TENANT_MODEL=gpt-4o-mini
# Intra-session identical-query cache (seconds); 0 disables TTL expiry check (not recommended)
CLASSIFIER_CACHE_TTL_SECONDS=600
CLASSIFIER_CACHE_MAX_ITEMS=500
# Heuristic pre-classifier: skip LLM when confidence >= threshold; set 0 to disable
PRE_CLASSIFIER_MIN_CONFIDENCE=0.92

# --- Rate limiting (stretch) ---
# Max /chat requests per user per window; 0 disables
RATE_LIMIT_PER_WINDOW=0
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# Optional — only set what you actually use
# =============================================================================

# --- Persistence (your choice) ---
# Sessions can be persisted to Postgres, SQLite, or kept in-memory for the
# assignment. Set this only if you choose Postgres / a real DB.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=

# --- Pre-classifier vector DB ---
# Only if you implement the optional embedding-based pre-classifier (stretch).
PGVECTOR_DATABASE_URL=

# --- Cache backend ---
# Only if you implement the optional dedupe cache (stretch) and choose Redis.
# Leave blank to use in-memory caching.
REDIS_URL=
